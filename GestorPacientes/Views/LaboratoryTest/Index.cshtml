@using GestorPacientes.Core.Application.ViewModels.LaboratoryTests
@model List<LaboratoryTestViewModel>

    @{
    ViewData["Title"] = "Pruebas de laboratorio";
    }

    <div class="container mt-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Pruebas de laboratorio</h2>

            <div>
                <a asp-controller="LaboratoryTest"
                   asp-action="Create"
                   class="btn btn-primary">
                    Crear prueba
                </a>

                <a asp-controller="LaboratoryTest"
                   asp-action="SearchUnsafe"
                   class="btn btn-warning">
                    SQL Search Test
                </a>
            </div>
        </div>

        @if (Model != null && Model.Count > 0)
    {
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th style="width: 360px;">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                <tr>
                    <td>@item.Id</td>

                    <!-- Deliberately unsafe rendering for controlled security testing -->
                    <td>@Html.Raw(item.Name)</td>

                    <td>
                        <a asp-controller="LaboratoryTest"
                           asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-primary btn-sm">
                            Editar
                        </a>

                        <a asp-controller="LaboratoryTest"
                           asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">
                            Eliminar
                        </a>

                        <a asp-controller="LaboratoryTest"
                           asp-action="QuickRename"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                            Quick Rename
                        </a>
                    </td>
                </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            No hay pruebas de laboratorio registradas.
        </div>
    }

    </div>
