@{
    ViewData["Title"] = "Login Audit";

    string username =
        ViewBag.Username as string ?? string.Empty;

    string patientId =
        ViewBag.PatientId as string ?? string.Empty;

    string message =
        ViewBag.Message as string ?? string.Empty;

    string error =
        ViewBag.Error as string ?? string.Empty;
}

<div class="container mt-4">
    <h2>Login Audit</h2>

    <form method="post"
          asp-controller="Home"
          asp-action="LoginAudit">

        <div class="mb-3">
            <label class="form-label">
                Username
            </label>

            <input type="text"
                   name="username"
                   value="@username"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">
                Password
            </label>

            <input type="password"
                   name="password"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">
                Patient ID
            </label>

            <input type="text"
                   name="patientId"
                   value="@patientId"
                   class="form-control" />
        </div>

        <button type="submit"
                class="btn btn-primary">
            Submit
        </button>
    </form>

    @if (!string.IsNullOrWhiteSpace(error))
    {
    <div class="alert alert-danger mt-4">
        @error
    </div>
    }

    @if (!string.IsNullOrWhiteSpace(message))
    {
    <div class="alert alert-success mt-4">
        @message
    </div>
    }
</div>