@{
    ViewData["Title"] = "Patient Data Encryption";

    string patientData =
        ViewBag.PatientData as string ?? string.Empty;

    string encryptedData =
        ViewBag.EncryptedData as string ?? string.Empty;

    string error =
        ViewBag.Error as string ?? string.Empty;
}

<div class="container mt-4">
    <h2>Patient Data Encryption</h2>

    <p class="text-muted">
        Enter demonstration patient data to encrypt.
    </p>

    <form method="post"
          asp-controller="Home"
          asp-action="EncryptPatientData">

        <div class="mb-3">
            <label class="form-label">
                Patient data
            </label>

            <textarea name="patientData"
                      class="form-control"
                      rows="6"
                      placeholder="TEST-PATIENT-001">@patientData</textarea>
        </div>

        <button type="submit"
                class="btn btn-primary">
            Encrypt
        </button>
    </form>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger mt-4">
            @error
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(encryptedData))
    {
        <div class="card mt-4">
            <div class="card-header">
                Encrypted result
            </div>

            <div class="card-body">
                <code style="word-break: break-all;">
                    @encryptedData
                </code>
            </div>
        </div>
    }
</div>